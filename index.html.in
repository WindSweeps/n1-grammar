<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>N1 语法思维导图 · 文法の森</title>
<style>
:root{--canvas:#f5f5ef;--surface:#fffefa;--ink:#203b32;--muted:#63736a;--line:#dbe1d6;--green:#285c49;--tint:#eaf0e5;--gold:#a86035;--focus:#b15a28;--shadow:0 12px 40px #203b3210;--sans:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;--serif:"Songti SC","Noto Serif CJK SC","Hiragino Mincho ProN",Georgia,serif}
*{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--canvas);font-family:var(--sans);font-size:14px;line-height:1.6}button,input,select{font:inherit}button,a,input,select{-webkit-tap-highlight-color:transparent}button{cursor:pointer;color:inherit}button:disabled{cursor:default;opacity:.5}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--focus);outline-offset:4px}button{border:0}a{color:var(--green);text-underline-offset:4px}h1,h2,h3,p{margin:0}button:hover{filter:brightness(.97)}.wrap{max-width:1760px;margin:auto;padding:0 36px}.top{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:12px}.brand-mark{width:34px;height:38px;background:var(--green);color:#fffefa;display:grid;place-items:center;font-family:var(--serif);font-size:22px;border-radius:10px 3px}.brand strong{font-family:var(--serif);font-size:21px;font-weight:600}.brand small{margin-left:15px;font-size:11px;letter-spacing:2px;color:var(--muted)}.top-actions{display:flex;gap:12px;align-items:center}.plain,.primary,.secondary{min-height:42px;padding:9px 16px;border-radius:7px;display:inline-flex;align-items:center;justify-content:center;gap:7px}.plain{background:transparent;color:var(--muted)}.primary{background:var(--green);color:white}.secondary{border:1px solid var(--line);background:var(--surface)}.intro{display:flex;align-items:flex-end;justify-content:space-between;padding:29px 0 24px;gap:24px}.eyebrow{font-size:11px;font-weight:650;letter-spacing:2px;color:var(--gold);margin-bottom:5px}h1{font-size:32px;letter-spacing:1px;font-family:var(--serif);font-weight:600;line-height:1.5}.intro p{color:var(--muted);font-size:13px;margin-top:6px}.intro-note{text-align:right;min-width:182px}.intro-note strong{font-family:Georgia,serif;font-size:25px;font-weight:400}.intro-note span{font-size:12px;color:var(--muted);margin:0 5px}.intro-note .line{height:4px;background:var(--line);border-radius:4px;margin-top:10px;overflow:hidden}.intro-note .line i{display:block;background:var(--green);height:100%;width:0;transition:width .2s}.workspace{display:grid;grid-template-columns:180px minmax(0,1fr) 330px;gap:22px;align-items:start}.sidebar{padding-top:4px;position:sticky;top:20px}.nav-title{font-size:11px;color:var(--muted);letter-spacing:1.5px;padding:0 12px 10px}.nav-item{width:100%;display:flex;align-items:center;text-align:left;gap:9px;min-height:42px;background:transparent;border-radius:7px;padding:9px 11px;margin-bottom:3px;font-size:13px}.nav-item.active{background:var(--green);color:#fff}.nav-item .number{font-size:10px;opacity:.65;font-variant-numeric:tabular-nums}.nav-item .count{margin-left:auto;font-size:10px;opacity:.7}.nav-sep{height:1px;background:var(--line);margin:13px 10px}.nav-caption{font-size:11px;color:var(--muted);padding:15px 11px}.mobile-nav{display:none}.center{min-width:0}.map-panel{border:1px solid var(--line);background:var(--surface);border-radius:13px;overflow:hidden;box-shadow:var(--shadow)}.tools{display:flex;align-items:center;gap:12px;padding:15px 18px;border-bottom:1px solid var(--line)}.searchbox{display:flex;align-items:center;gap:9px;flex:1;min-width:0;background:#f4f5ef;border:1px solid transparent;border-radius:7px;padding:0 11px}.searchbox:focus-within{border-color:var(--green)}.searchbox span{font-size:18px;color:var(--muted)}.searchbox input{border:0;background:transparent;outline:none;min-width:0;width:100%;height:40px;color:var(--ink);font-size:12px}.clear{background:transparent;font-size:19px;padding:0 3px;color:var(--muted)}select{background:var(--surface);border:1px solid var(--line);color:var(--ink);border-radius:7px;min-height:40px;padding:7px 25px 7px 9px;font-size:12px;max-width:140px}.map-heading{padding:17px 22px 0;display:flex;justify-content:space-between;align-items:center;gap:10px}.crumb{font-size:12px;color:var(--muted);background:transparent;padding:0;min-height:30px}.crumb b{color:var(--ink);font-weight:550}.map-tag{font-size:10px;white-space:nowrap;color:var(--muted);letter-spacing:.5px}.mindmap{position:relative;min-height:622px;padding:22px;display:grid;grid-template-columns:minmax(0,1fr) 112px minmax(0,1fr);grid-template-rows:repeat(6,1fr);column-gap:24px;row-gap:12px;align-items:center}.mindmap.category{min-height:554px;grid-template-rows:repeat(5,1fr)}.branches{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}.branches path{fill:none;stroke:#c5d4c4;stroke-width:1.3}.root-node{z-index:1;grid-column:2;grid-row:1/-1;width:112px;height:112px;align-self:center;justify-self:center;display:flex;align-items:center;justify-content:center;flex-direction:column;background:var(--green);color:white;border-radius:50%;box-shadow:0 0 0 8px var(--surface),0 0 0 9px #d3ddcf}.root-node strong{font-family:var(--serif);font-size:26px;font-weight:500;line-height:1.3}.root-node span{font-size:12px;margin-top:6px}.root-node small{font-size:9px;color:#d2e2d3;letter-spacing:.5px}.category .root-node strong{font-family:var(--sans);font-size:15px;max-width:90px}.node{z-index:1;position:relative;background:var(--surface);border:1px solid var(--line);border-radius:8px;text-align:left;padding:12px 14px;min-height:78px;width:100%;display:flex;flex-direction:column;justify-content:center;transition:border-color .15s,background .15s}.node:hover{border-color:#7b9b83;background:#f7faf2;filter:none}.node.selected{border-color:var(--green);background:var(--tint);box-shadow:0 0 0 1px var(--green)}.node .node-title{font-size:14px;font-weight:550;line-height:1.4;overflow-wrap:anywhere}.node.grammar .node-title{font-family:var(--serif);font-size:16px}.node .node-sub{font-size:11px;color:var(--muted);margin-top:5px;line-height:1.5}.node .node-num{font-size:9px;color:var(--gold);position:absolute;right:9px;top:6px}.node .state-dot{position:absolute;right:8px;bottom:7px;font-size:10px;color:var(--green)}.node.group{padding-right:26px}.node.group .node-title{font-size:13px}.node.done{border-left:3px solid var(--green)}.map-foot{border-top:1px solid var(--line);padding:12px 20px;display:flex;justify-content:space-between;align-items:center;gap:10px;color:var(--muted);font-size:10px}.key{display:flex;align-items:center;gap:12px}.key span{white-space:nowrap}.key i{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--green);margin-right:5px}.under-map{padding:16px 3px;display:flex;justify-content:space-between;gap:12px;font-size:11px;color:var(--muted)}.under-map button{font-size:11px;padding:0;background:transparent;color:var(--green);text-decoration:underline;text-underline-offset:4px}.detail{background:var(--surface);border:1px solid var(--line);border-radius:13px;overflow:hidden;position:sticky;top:20px;box-shadow:var(--shadow)}.detail-inner{padding:22px}.detail-kicker{font-size:10px;color:var(--gold);letter-spacing:1.5px;text-transform:uppercase}.detail h2{font-family:var(--serif);font-size:25px;font-weight:550;line-height:1.55;margin:10px 0 8px;overflow-wrap:anywhere}.detail .meaning{font-size:14px;color:var(--green);line-height:1.65;margin-bottom:18px}.detail-block{padding:16px 0;border-top:1px solid var(--line)}.label{font-size:10px;letter-spacing:1px;color:var(--muted);margin-bottom:7px;font-weight:600}.detail-block p{font-size:12px;line-height:1.9}.connection{font-family:var(--sans);background:#f0f3ec;border-radius:6px;padding:11px 12px;font-size:12px;line-height:1.8}.example{font-family:var(--serif);font-size:17px!important;line-height:1.9!important}.translation{color:var(--muted);font-size:12px;line-height:1.7;margin-top:9px}.translation-btn{font-size:11px;padding:3px 0;background:transparent;color:var(--green);margin-top:5px;text-decoration:underline;text-underline-offset:4px;min-height:32px}.cue{padding:12px 13px;border-left:2px solid #ba9160;background:#f8f3e8;border-radius:0 6px 6px 0;font-size:12px;line-height:1.8}.detail-actions{display:flex;gap:8px;position:sticky;bottom:0;padding:13px 18px;background:var(--surface);border-top:1px solid var(--line)}.detail-actions .primary,.detail-actions .secondary{flex:1;font-size:12px}.detail-actions .star{flex:0 0 74px}.detail-nav{display:flex;justify-content:space-between;margin-top:17px;gap:10px}.detail-nav button{background:transparent;min-height:34px;color:var(--muted);font-size:11px}.related{display:flex;flex-wrap:wrap;gap:6px}.related button{background:var(--tint);padding:5px 8px;border-radius:5px;min-height:32px;font-size:11px}.source-links{font-size:10px;color:var(--muted);margin-top:10px;overflow-wrap:anywhere}.source-links a{display:block;margin-top:5px}.bridge{display:inline-block;border:1px solid #cab388;color:#805a2f;padding:2px 6px;font-size:9px;border-radius:4px;margin-bottom:8px}.guide-title{font-family:var(--serif);font-size:27px;line-height:1.8;margin:10px 0}.guide-copy{font-size:12px;color:var(--muted);line-height:1.9}.guide-steps{margin:23px 0 20px}.step{display:grid;grid-template-columns:24px 1fr;gap:10px;padding:15px 0;border-top:1px solid var(--line)}.step b{font-family:Georgia,serif;color:var(--gold);font-size:17px;font-weight:400}.step strong{font-size:12px;font-weight:550}.step p{font-size:11px;color:var(--muted);margin-top:4px}.guide-prompt{padding:15px;background:var(--tint);border-radius:8px;font-family:var(--serif);font-size:15px;line-height:1.9}.result-area{padding:20px;min-height:540px}.result-heading{font-size:12px;color:var(--muted);margin:0 0 17px}.result-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.result-grid .node{min-height:88px}.empty{padding:80px 20px;text-align:center;color:var(--muted)}.empty strong{font-family:var(--serif);font-size:24px;color:var(--ink);font-weight:500}.empty p{font-size:12px;margin-top:12px}.empty button{margin-top:20px}.compare-list{display:grid;gap:16px}.compare{border:1px solid var(--line);border-radius:9px;padding:18px}.compare h3{font-size:15px;font-family:var(--serif);font-weight:600;margin-bottom:7px}.compare>p{font-size:12px;color:var(--muted);margin-bottom:12px}.compare-row{border-top:1px solid var(--line);padding-top:10px;margin-top:10px}.compare-row button{padding:0;min-height:32px;text-align:left;background:transparent;font-family:var(--serif);font-size:16px;color:var(--green)}.compare-row p{font-size:12px;line-height:1.8}.close-detail{display:none}.footer{border-top:1px solid var(--line);padding:22px 0 28px;margin-top:10px;display:flex;justify-content:space-between;gap:20px;font-size:10px;color:var(--muted)}.footer a{font-size:10px}.footer p{max-width:830px}.toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%);background:var(--ink);color:white;padding:10px 18px;border-radius:8px;z-index:40;box-shadow:var(--shadow);font-size:12px;max-width:90vw;text-align:center}.hidden,[hidden]{display:none!important}dialog{color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:16px;box-shadow:0 30px 90px #18362630;padding:0;width:min(600px,calc(100vw - 30px));max-height:90vh}dialog::backdrop{background:#213b325b;backdrop-filter:blur(3px)}.modal-head{display:flex;justify-content:space-between;align-items:center;padding:18px 25px;border-bottom:1px solid var(--line)}.modal-head h2{font-size:14px;font-weight:600}.icon-close{background:transparent;font-size:24px;min-width:36px;min-height:36px;line-height:1}.modal-body{padding:26px}.quiz-meta{display:flex;justify-content:space-between;color:var(--muted);font-size:11px}.quiz-pattern{font-family:var(--serif);font-weight:500;font-size:32px;text-align:center;padding:25px 0 16px;line-height:1.6;overflow-wrap:anywhere}.quiz-example{font-size:18px;text-align:center;font-family:var(--serif);line-height:1.9}.quiz-hint{text-align:center;color:var(--muted);font-size:12px;margin:18px 0 23px}.quiz-reveal{padding:18px;background:var(--tint);border-radius:9px;margin-top:20px}.quiz-reveal strong{font-size:17px;font-weight:500}.quiz-reveal p{font-size:13px;line-height:1.9;margin-top:8px}.quiz-buttons{display:flex;gap:10px;margin-top:22px}.quiz-buttons button{flex:1}.quiz-progress{height:3px;background:var(--line)}.quiz-progress i{height:100%;display:block;background:var(--green)}.help-body{font-size:13px;line-height:1.9}.help-body h3{font-size:14px;margin:20px 0 5px}.help-body h3:first-child{margin-top:0}.help-body ul{padding-left:19px;margin:8px 0}.help-body p{margin:8px 0}.help-body a{overflow-wrap:anywhere}.save-note{font-size:11px;color:var(--muted)}.backup-controls{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.backup-controls button{font-size:12px}.backdrop{display:none}
@media(min-width:1600px){.workspace{grid-template-columns:200px minmax(0,1fr) 355px;gap:26px}.mindmap{column-gap:40px;padding:28px}.node{min-height:82px;padding:13px 19px}}
@media(max-width:1270px){.workspace{grid-template-columns:162px minmax(0,1fr);gap:18px}.detail{display:none}.detail.mobile-open{display:block;position:fixed;top:0;right:0;bottom:0;border-radius:16px 0 0 16px;width:380px;max-width:94vw;overflow:auto;z-index:31;box-shadow:-20px 0 80px #18362620}.close-detail{display:flex;justify-content:space-between;align-items:center;padding:12px 20px;border-bottom:1px solid var(--line);font-size:11px;color:var(--muted)}.backdrop.open{display:block;position:fixed;inset:0;background:#203b3255;z-index:30}.wrap{padding:0 28px}.mindmap{min-height:610px}.intro{padding:25px 0 22px}}
@media(max-width:760px){.wrap{padding:0 16px}.top{height:66px}.brand small{display:none}.brand strong{font-size:18px}.top-actions{gap:1px}.top-actions .plain{padding:8px 9px;font-size:11px}.top-actions .primary{padding:8px 12px;min-height:38px;font-size:12px}.brand-mark{width:29px;height:32px;font-size:19px}.intro{padding:23px 0 19px;align-items:center;gap:8px}h1{font-size:25px;letter-spacing:0}.intro p{font-size:11px;max-width:225px}.eyebrow{font-size:9px;letter-spacing:1.3px}.intro-note{min-width:65px}.intro-note strong{font-size:22px}.intro-note span{font-size:10px;margin:0 2px}.intro-note .total-label{display:none}.workspace{display:block}.sidebar{display:none}.mobile-nav{display:flex;gap:7px;padding:0 0 12px;align-items:center}.mobile-nav select{flex:1;max-width:none;min-width:0;font-size:12px}.mobile-nav button{font-size:11px;min-height:40px;padding:7px 11px}.tools{padding:12px;gap:7px}.tools select{width:93px;flex:0 0 93px}.searchbox{padding:0 8px}.searchbox input{font-size:11px}.map-heading{padding:12px 15px 0}.map-tag{font-size:9px}.mindmap,.mindmap.category{display:flex;flex-direction:column;align-items:stretch;gap:12px;padding:24px 18px 25px 51px;min-height:0}.mindmap::before{content:"";position:absolute;left:29px;top:45px;bottom:64px;border-left:1px solid #bbceb9}.branches{display:none}.root-node{align-self:flex-start;justify-self:auto;width:auto;height:auto;min-height:46px;border-radius:8px;box-shadow:none;flex-direction:row;gap:9px;padding:10px 14px;margin:0 0 10px -39px}.root-node strong,.category .root-node strong{font-family:var(--serif);font-size:18px;max-width:none}.root-node span{margin:0;font-size:11px}.root-node small{font-size:9px}.node{min-height:70px;padding:12px 15px}.node:before{content:"";position:absolute;width:23px;border-top:1px solid #bbceb9;left:-23px;top:50%}.node.group .node-title{font-size:14px}.node .node-sub{font-size:11px}.node.grammar .node-title{font-size:17px}.node .node-num{font-size:10px;right:12px;top:9px}.map-foot{padding:11px 15px;font-size:9px;flex-wrap:wrap}.under-map{font-size:10px;align-items:flex-start}.under-map span{max-width:65%}.result-grid{grid-template-columns:1fr}.result-area{padding:16px;min-height:400px}.result-area .node::before{display:none}.footer{font-size:10px;flex-direction:column;gap:8px}.footer p{line-height:1.9}.modal-body{padding:20px}.quiz-pattern{font-size:27px}.quiz-example{font-size:17px}.detail.mobile-open{width:420px}.compare{padding:14px}.intro-note .line{margin-top:5px}.help-body{font-size:12px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
@media print{.top-actions,.sidebar,.tools,.mobile-nav,.detail-actions,.under-map,.intro-note,.close-detail,.footer,.backdrop,.toast{display:none!important}.wrap{padding:0}.workspace{display:block}.detail{display:block;position:static;border:0;box-shadow:none}.map-panel{box-shadow:none}.mindmap{break-inside:avoid}.detail-inner{padding:20px 0}body{background:white}.intro{padding:14px 0}}
</style>
</head>
<body>
<div class="wrap" id="app">
<header class="top"><div class="brand"><span class="brand-mark" aria-hidden="true">文</span><strong lang="ja">文法の森</strong><small>GRAMMAR ATLAS</small></div><div class="top-actions"><button class="plain" id="helpBtn">使用指南</button><button class="primary" id="quizBtn">开始自测 <span aria-hidden="true">↗</span></button></div></header>
<section class="intro"><div><div class="eyebrow">JLPT N1 · 按语义建立连接</div><h1>N1 语法思维导图</h1><p>先理解一句话想表达什么，再记住它如何表达。</p></div><div class="intro-note" aria-live="polite"><strong id="masteredCount">0</strong><span>/ <span id="totalCount">108</span><span class="total-label"> 已掌握</span></span><div class="line" role="progressbar" aria-label="学习进度" aria-valuemin="0" aria-valuemax="108" aria-valuenow="0"><i id="progressFill"></i></div></div></section>
<div class="workspace">
<aside class="sidebar" aria-label="语法分类"><div class="nav-title">学习路径</div><nav id="categoryNav"></nav><div class="nav-sep"></div><button class="nav-item" id="compareBtn"><span aria-hidden="true">⇄</span> 易混辨析 <span class="count">8 组</span></button><div class="nav-caption">理解 → 对比 → 回想<br>每天走完一个分支。</div></aside>
<main class="center" id="main"><div class="mobile-nav"><label for="mobileCategory" class="hidden">语法分类</label><select id="mobileCategory" aria-label="选择语法分类"></select><button class="secondary" id="mobileCompare">⇄ 易混辨析</button></div><section class="map-panel" aria-label="交互思维导图"><div class="tools"><div class="searchbox"><span aria-hidden="true">⌕</span><input type="search" id="search" placeholder="搜索语法、中文含义或接续…" aria-label="搜索全部语法" autocomplete="off"><button class="clear" type="button" id="clearSearch" aria-label="清空搜索" hidden>×</button></div><select id="filter" aria-label="学习状态筛选"><option value="all">全部语法</option><option value="new">待学习</option><option value="known">已掌握</option><option value="star">已收藏</option></select></div><div class="map-heading"><button class="crumb" id="breadcrumb">语法地图 / <b>全景</b></button><span class="map-tag" id="mapTag">12 个语义分支</span></div><div id="mapContent"></div><div class="map-foot"><span id="mapHint">点击分支展开 · 点击中心返回全景</span><div class="key"><span><i></i>已掌握</span><span>☆ 收藏留待复习</span></div></div></section><div class="under-map"><span id="storageNote">学习进度自动保存在当前浏览器</span><button id="sourceBtn">范围与参考来源 ↗</button></div></main>
<aside class="detail" id="detail" aria-label="语法详情"><div class="close-detail"><span>语法学习卡</span><button class="icon-close" id="closeDetail" aria-label="关闭语法详情">×</button></div><div id="detailContent"></div></aside>
</div>
<footer class="footer"><p>收录 <span id="footerTotal">108</span> 个学习条目（含部分 N2 衔接项与不同用法）。按常见备考范围整理；JLPT 未公布固定的 N1 语法清单。本页例句为原创，非官方试题。</p><span>学习地图 · 2026.10 <a href="https://www.jlpt.jp/e/faq/" target="_blank" rel="noopener noreferrer">JLPT 官方说明 ↗</a></span></footer>
</div>
<div class="backdrop" id="detailBackdrop"></div><div class="toast" id="toast" role="status" hidden></div>
<dialog id="quizDialog" aria-labelledby="quizTitle"><div class="modal-head"><h2 id="quizTitle">回想练习</h2><button class="icon-close" id="closeQuiz" aria-label="关闭自测">×</button></div><div id="quizContent"></div></dialog>
<dialog id="helpDialog" aria-labelledby="helpTitle"><div class="modal-head"><h2 id="helpTitle">把导图变成自己的语法记忆</h2><button class="icon-close" id="closeHelp" aria-label="关闭使用指南">×</button></div><div class="modal-body help-body"><h3>一个分支，三遍学习</h3><p>① 看中文语义，选一个分支，点击语法节点读接续。<br>② 看日语例句，先自己翻译，再展开中文。<br>③ 点「开始自测」，回想含义和接续，再查看答案。</p><p>自测会从当前分类与筛选结果中抽取最多 10 条；在全景中可复习全部语法。「记住了」会标记掌握，「还没记住」会取消掌握，便于稍后筛选。</p><h3>接续速查</h3><p>V = 动词；N = 名词；イ形 = い形容词；ナ形 = な形容词。「ます形去ます」如 読みます → 読み；「ない形去ない」如 読まない → 読ま。各条目列出的接法与特例优先。</p><h3>进度与离线使用</h3><p>HTML 内置全部内容，无需联网即可搜索和自测。收藏与掌握状态存于当前浏览器；更换浏览器、移动文件或清理数据可能影响保存。可导出进度备份，导入会合并已有记录。</p><div class="backup-controls"><button class="secondary" id="exportBtn">导出学习进度</button><button class="secondary" id="importBtn">导入学习进度</button><input type="file" id="importFile" accept="application/json,.json" hidden></div><h3>收录范围</h3><p>这是按语义编排的常见 N1 备考语法学习集，包含相近用法与少量明确标注的 N2 衔接项，不宣称覆盖全部考点。教材对语法级别的归类可能不同。</p><p>官方说明：新版考试不公开逐项词汇、汉字和语法清单。<a href="https://www.jlpt.jp/e/faq/" target="_blank" rel="noopener noreferrer">JLPT FAQ ↗</a></p><h3>参考与使用方式</h3><p>中文释义、分类、记忆提示和例句为本页编写。语法卡片附已查阅的参考链接；没有单独来源的条目为编辑整理。以下来源用于范围与重点用法核对，不代表逐条获得官方认定。</p><div id="sourceList"></div><p class="save-note">建议与教材、阅读上下文及官方样题配合学习。近义句型往往有交集，辨析提示用于建立重点，并非绝对互斥规则。</p></div></dialog>
<script id="grammarData" type="application/json">__GRAMMAR_DATA__</script>
<script>
'use strict';
const DATA=JSON.parse(document.getElementById('grammarData').textContent);
const CATS=[
{id:'time',name:'时间与进程',hint:'刚一… · 自从… · 直到…',prompt:'动作在什么时候发生？'},
{id:'conditions',name:'条件与前提',hint:'如果… · 取决于… · 有了…才',prompt:'什么条件，才能让后项成立？'},
{id:'concession',name:'让步与逆接',hint:'即使… · 虽说… · 明明…',prompt:'前项成立，为什么仍然相反？'},
{id:'cause',name:'原因与结果',hint:'正因为… · 由于… · 结果竟…',prompt:'因为什么，又落到什么结果？'},
{id:'degree',name:'程度与极限',hint:'极其… · 无比… · …得过头',prompt:'说话人把程度推到了哪里？'},
{id:'judgment',name:'判断与可能',hint:'一定… · 无须… · 不可能…',prompt:'说话人如何评估这件事？'},
{id:'emotion',name:'情感与自发',hint:'禁不住… · 不得不… · 不忍…',prompt:'是什么力量，让动作无法避免？'},
{id:'evaluation',name:'评价与立场',hint:'身为… · 相比… · 无视…',prompt:'从什么立场看，才有这样的评价？'},
{id:'scope',name:'范围与限定',hint:'唯有… · 不止… · 连…也',prompt:'边界在哪里，哪些也被包含？'},
{id:'manner',name:'方式与伴随',hint:'顺便… · 一边… · 宛如…',prompt:'两件事以什么方式同时发生？'},
{id:'intention',name:'意志与应对',hint:'为了… · 禁止… · 大不了…',prompt:'想要做什么，又如何作出应对？'},
{id:'topic',name:'话题与表述',hint:'说起… · 也就… · 与其说…',prompt:'如何引出话题、限定或换种说法？'}
];
const BYID=Object.fromEntries(DATA.map(d=>[d.id,d]));
const CAT=Object.fromEntries(CATS.map(c=>[c.id,c]));
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const KEY='bunpo-atlas-n1-v1';
let progress={known:[],star:[]},storageOK=true;
try{const saved=JSON.parse(localStorage.getItem(KEY)||'null');if(saved)for(const k of ['known','star'])if(Array.isArray(saved[k]))progress[k]=[...new Set(saved[k].filter(id=>BYID[id]))];}catch{storageOK=false;}
let selectedCat=null,selectedId=null,mode='map',query='',filter='all',translationOpen=false,lastDetailTrigger=null;
let quiz=[],quizIndex=0,quizRemembered=0,quizAnswered=false,toastTimer;
const bridgeIds=new Set(['conditions-04','concession-07','judgment-01','judgment-02','judgment-03','evaluation-05','intention-05','intention-07','scope-07','topic-05','topic-09']);
function toast(msg){$('#toast').textContent=msg;$('#toast').hidden=false;clearTimeout(toastTimer);toastTimer=setTimeout(()=>{$('#toast').hidden=true;},2500);}
function save(){try{localStorage.setItem(KEY,JSON.stringify(progress));}catch{storageOK=false;toast('浏览器无法保存进度，可在使用指南导出备份。');}updateProgress();}
function updateProgress(){const n=progress.known.length;$('#masteredCount').textContent=n;$('#totalCount').textContent=DATA.length;$('#footerTotal').textContent=DATA.length;$('#progressFill').style.width=n/DATA.length*100+'%';$('.line').setAttribute('aria-valuenow',n);$('.line').setAttribute('aria-valuemax',DATA.length);$('#storageNote').textContent=storageOK?'学习进度自动保存在当前浏览器':'当前环境无法保存进度，可在使用指南导出备份';}
function visibleData(){return DATA.filter(d=>(!selectedCat||d.category===selectedCat)&&(!query||[d.pattern,d.meaning,d.connection,d.nuance,d.example,d.cue,CAT[d.category].name].some(v=>v.toLowerCase().includes(query.toLowerCase())))&&(filter==='all'||filter==='known'&&progress.known.includes(d.id)||filter==='new'&&!progress.known.includes(d.id)||filter==='star'&&progress.star.includes(d.id)));}
function renderNav(){const navItem=(id,name,num,count)=>`<button class="nav-item ${mode==='map'&&selectedCat===id?'active':''}" data-cat="${id||''}" ${mode==='map'&&selectedCat===id?'aria-current="true"':''}><span class="number">${num}</span>${name}<span class="count">${count}</span></button>`;$('#categoryNav').innerHTML=navItem(null,'全景导图','◉',DATA.length)+CATS.map((c,i)=>navItem(c.id,c.name,String(i+1).padStart(2,'0'),DATA.filter(d=>d.category===c.id).length)).join('');$('#compareBtn').classList.toggle('active',mode==='compare');$('#mobileCategory').innerHTML='<option value="">全景导图</option>'+CATS.map(c=>`<option value="${c.id}">${c.name}</option>`).join('');$('#mobileCategory').value=selectedCat||'';}
function nodeHTML(d,style=''){const done=progress.known.includes(d.id),star=progress.star.includes(d.id);return `<button class="node grammar ${selectedId===d.id?'selected':''} ${done?'done':''}" data-entry="${d.id}" style="${style}" aria-pressed="${selectedId===d.id}"><span class="node-title" lang="ja">${esc(d.pattern)}</span><span class="node-sub">${esc(d.meaning)}</span><span class="state-dot" aria-label="${done?'已掌握 ':''}${star?'已收藏':''}">${done?'● ':''}${star?'★':''}</span></button>`;}
function renderMap(){renderNav();$('#clearSearch').hidden=!query;$('#search').value=query;$('#filter').value=filter;$('#breadcrumb').innerHTML=`语法地图 / <b>${mode==='compare'?'易混辨析':selectedCat?CAT[selectedCat].name:'全景'}</b>`;
 if(mode==='compare'){renderCompare();return;}
 const list=visibleData(),isFiltered=!!query||filter!=='all';
 $('#quizBtn').disabled=!list.length;$('#mapTag').textContent=isFiltered?list.length+' 个匹配条目':selectedCat?list.length+' 个学习节点':'12 个语义分支';
 $('#mapHint').textContent=isFiltered?'点击结果查看语法卡片':'点击分支展开 · 点击中心返回全景';
 if(isFiltered){$('#mapContent').innerHTML=`<div class="result-area"><p class="result-heading">${query?'搜索「'+esc(query)+'」':'按学习状态筛选'}${selectedCat?' · '+CAT[selectedCat].name:' · 全部分类'}</p>${list.length?'<div class="result-grid">'+list.map(d=>nodeHTML(d)).join('')+'</div>':'<div class="empty"><strong>这里暂时没有条目</strong><p>试试其他关键词，或返回全景并清除筛选。</p><button class="secondary" data-reset>显示全部语法</button></div>'}</div>`;return;}
 const nodes=selectedCat?list:CATS;
 const half=Math.ceil(nodes.length/2);
 const root=selectedCat?`<strong>${CAT[selectedCat].name}</strong><span>返回全景 ↑</span>`:'<strong>N1</strong><span lang="ja">日本語文法</span><small>从语义开始</small>';
 $('#mapContent').innerHTML=`<div class="mindmap ${selectedCat?'category':''}" role="group" aria-label="${selectedCat?CAT[selectedCat].name:'N1语法全景'}思维导图"><svg class="branches" aria-hidden="true"></svg><button class="root-node" id="mapRoot" aria-label="${selectedCat?'收起当前分支，返回全景':'N1语法全景'}">${root}</button>${nodes.map((d,i)=>{const style=`grid-column:${i<half?1:3};grid-row:${i%half+1}`;return selectedCat?nodeHTML(d,style):`<button class="node group" data-cat="${d.id}" style="${style}"><span class="node-num">${String(i+1).padStart(2,'0')}</span><span class="node-title">${d.name}</span><span class="node-sub">${d.hint}</span></button>`;}).join('')}</div>`;
 requestAnimationFrame(drawBranches);
}
function drawBranches(){const map=$('.mindmap'),svg=$('.branches'),root=$('#mapRoot');if(!map||!svg||!root||window.innerWidth<=760)return;const box=map.getBoundingClientRect(),r=root.getBoundingClientRect();svg.setAttribute('viewBox',`0 0 ${box.width} ${box.height}`);svg.innerHTML=[...map.querySelectorAll('.node')].map(node=>{const n=node.getBoundingClientRect(),left=n.left<r.left;const x1=(left?r.left:r.right)-box.left,y1=r.top+r.height/2-box.top,x2=(left?n.right:n.left)-box.left,y2=n.top+n.height/2-box.top;const mid=(x1+x2)/2;return `<path d="M ${x1} ${y1} C ${mid} ${y1},${mid} ${y2},${x2} ${y2}"/>`;}).join('');}
function chooseCategory(id){selectedCat=id||null;selectedId=null;mode='map';query='';filter='all';renderMap();renderDetail();}
function renderGuide(){const c=selectedCat?CAT[selectedCat]:null;$('#detailContent').innerHTML=`<div class="detail-inner"><div class="detail-kicker">${c?'分支学习 / '+c.name:'STUDY WITH CONNECTIONS'}</div><div class="guide-title">${c?c.prompt:'从语义出发，<br>把句型连起来。'}</div><p class="guide-copy">${c?'点击任一节点，依次学习中文含义、接续规则、日语例句与易混辨析。':'从左侧或导图选择一种语义，把相似表达放在一起学习。每一个节点，都是一张可复习的语法卡。'}</p><div class="guide-steps"><div class="step"><b>01</b><div><strong>看语义，建立连接</strong><p>先分清时间、条件、让步与情感。</p></div></div><div class="step"><b>02</b><div><strong>看接续，读懂语感</strong><p>留意意志、评价和书面语限制。</p></div></div><div class="step"><b>03</b><div><strong>遮住答案，主动回想</strong><p>收藏易忘项，按当前分支开始自测。</p></div></div></div><div class="guide-prompt">今日は、ひと枝ずつ。<br><span style="font-family:var(--sans);font-size:11px;color:var(--muted)">今天，从一个分支开始。</span></div></div>`;}
function renderDetail(){if(!selectedId){renderGuide();return;}const d=BYID[selectedId];const known=progress.known.includes(d.id),star=progress.star.includes(d.id);const related=(d.related||[]).filter(id=>BYID[id]);$('#detailContent').innerHTML=`<div class="detail-inner"><div class="detail-kicker">${CAT[d.category].name} / ${String(DATA.indexOf(d)+1).padStart(3,'0')}</div><h2 lang="ja">${esc(d.pattern)}</h2>${bridgeIds.has(d.id)?'<div class="bridge">跨级衔接 · 教材分级有差异</div>':''}<p class="meaning">${esc(d.meaning)}</p><div class="detail-block"><div class="label">接续 CONNECTION</div><div class="connection">${esc(d.connection)}</div></div><div class="detail-block"><div class="label">语感与限制</div><p>${esc(d.nuance)}</p></div><div class="detail-block"><div class="label">例句 · 先试着自己翻译</div><p class="example" lang="ja">${esc(d.example)}</p><button class="translation-btn" id="translationBtn" aria-expanded="${translationOpen}">${translationOpen?'收起中文译文':'查看中文译文'}</button><p class="translation" ${translationOpen?'':'hidden'}>${esc(d.translation)}</p></div><div class="detail-block"><div class="label">易混辨析</div><p>${esc(d.contrast)}</p></div><div class="cue"><strong>记忆线索</strong><br>${esc(d.cue)}</div>${related.length?'<div class="detail-block"><div class="label">连接着学</div><div class="related">'+related.map(id=>`<button data-entry="${id}" lang="ja">${esc(BYID[id].pattern)} ↗</button>`).join('')+'</div></div>':''}<div class="source-links">${(d.sources||[]).length?'参考核对：'+d.sources.map(s=>`<a href="${esc(s.url)}" target="_blank" rel="noopener noreferrer">${esc(s.title)} ↗</a>`).join(''):'编辑整理 · 原创例句'}</div><div class="detail-nav"><button data-prev>← 上一条</button><button data-next>下一条 →</button></div></div><div class="detail-actions"><button class="${known?'secondary':'primary'}" id="knownBtn" aria-pressed="${known}">${known?'✓ 已掌握':'标记掌握'}</button><button class="secondary star" id="starBtn" aria-pressed="${star}">${star?'★ 已收藏':'☆ 收藏'}</button></div>`;}
function openEntry(id){if(!BYID[id])return;lastDetailTrigger=document.activeElement;selectedId=id;translationOpen=false;renderMap();renderDetail();if(window.innerWidth<=1270){$('#detail').classList.add('mobile-open');$('#detailBackdrop').classList.add('open');$('#detail').setAttribute('role','dialog');$('#detail').setAttribute('aria-modal','true');$('#app').inert=true;/* detail lives in app: lift only during the dialog */document.body.appendChild($('#detail'));document.body.style.overflow='hidden';$('#closeDetail').focus();}$('#detail').scrollTop=0;}
function closeDetail(){const panel=$('#detail');panel.classList.remove('mobile-open');$('#detailBackdrop').classList.remove('open');panel.removeAttribute('role');panel.removeAttribute('aria-modal');$('#app').inert=false;$('.workspace').appendChild(panel);document.body.style.overflow='';const fallback=selectedId?document.querySelector(`[data-entry="${selectedId}"]`):null;if(lastDetailTrigger?.isConnected)lastDetailTrigger.focus();else if(fallback)fallback.focus();}
function toggleProgress(key){if(!selectedId)return;const active=progress[key].includes(selectedId);progress[key]=active?progress[key].filter(id=>id!==selectedId):[...progress[key],selectedId];save();renderMap();renderDetail();toast(key==='known'?(active?'已移回待学习':'已标记掌握'):(active?'已取消收藏':'已加入收藏'));}
function stepEntry(direction){const list=mode==='compare'?DATA:visibleData();if(!list.length)return;let i=list.findIndex(d=>d.id===selectedId);i=(i+direction+list.length)%list.length;openEntry(list[i].id);}
const COMPARISONS=[
{title:'一…就…：都快，焦点不同',note:'三者都常描述已经发生的紧接事件；不要只用中文翻译区分。',items:[['time-01','动作刚发生，后项立刻发生，强调间隔极短。'],['time-02','“刚一…就…”，常带出迅速的反应，偏书面。'],['time-03','同一主体随即做出后续动作，常含意外感。']]},
{title:'顺便做，还是同时兼顾？',note:'先判断两件事是同一次外出，还是长期并行。',items:[['manner-01','主行动顺便兼做另一件事，多见于移动、外出。'],['manner-02','借做某事的机会兼做另一件事，表达正式，常用于问候。'],['manner-03','以某事为主要工作或生活，一面长期兼做另一件事。']]},
{title:'没有 A，就没有 B',note:'都能表达必要条件，接续和观察角度不同。',items:[['conditions-03','接名词，强调缺少必要条件，后项通常否定。'],['conditions-04','名词＋なしには，常与不可能、无法做到相呼应。'],['conditions-05','A あっての B：正是有 A 才成立的 B，用名词结构肯定 A。']]},
{title:'不可避免：引发，还是责任？',note:'注意句子的主语和“不得不”的来源。',items:[['emotion-04','引发某种反应，或强烈决意要使某事发生。'],['emotion-05','若不这样做就说不过去，侧重责任、常识或局势。'],['emotion-02','受外部情况所迫，被迫做某事。']]},
{title:'に堪えない：感情，还是评价？',note:'相同表面形式，前面的词类和意义改变解读。',items:[['degree-07','名词＋に堪えない：感激、遗憾等感情强烈。'],['degree-08','动词辞书形＋に堪えない：不值得看、听，或不忍承受。'],['emotion-08','动词辞书形＋に忍びない：因情感上不忍心而难以做。']]},
{title:'无须做：不必要，与不至于',note:'这些表达常是说话人的判断，而不是能力不足。',items:[['judgment-04','没有必要特地做到那一步；“言うまでもない”也是常用搭配。'],['intention-09','不必做；接名词时也可表示比不上，需看结构。'],['judgment-05','事情没有达到值得惊讶、责备等程度。']]},
{title:'目的，必然，禁令',note:'别被共同出现的「べ」误导，要整块记忆。',items:[['intention-01','为了某个目标而行动，偏正式书面表达。'],['intention-02','前置条件已具备，出现这样的结果是必然的。'],['intention-03','书面禁令：不许…；并非普通的“不应该”。']]},
{title:'三个「なり」：接法决定读法',note:'先看なり前的形式，以及它是否成对出现。',items:[['time-03','动词辞书形＋なり：刚一…就…（直后）。'],['topic-06','名词等＋なりに／なりの：有其自身方式或相应程度。'],['topic-07','A なり B なり：列举可选方案，如…或…。']]}
];
function renderCompare(){$('#quizBtn').disabled=false;$('#mapTag').textContent='8 组核心辨析';$('#mapHint').textContent='点击句型打开完整语法卡';$('#mapContent').innerHTML='<div class="result-area"><p class="result-heading">先找差异，再连回语法节点。</p><div class="compare-list">'+COMPARISONS.map(c=>`<article class="compare"><h3>${c.title}</h3><p>${c.note}</p>${c.items.filter(([id])=>BYID[id]).map(([id,why])=>`<div class="compare-row"><button data-entry="${id}" lang="ja">${esc(BYID[id].pattern)} ↗</button><p>${why}</p></div>`).join('')}</article>`).join('')+'</div></div>';}
function showCompare(){mode='compare';selectedId=null;query='';filter='all';selectedCat=null;renderMap();renderDetail();}
function startQuiz(){const pool=mode==='compare'?DATA:visibleData();if(!pool.length){toast('当前没有可自测的条目');return;}quiz=[...pool];for(let i=quiz.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[quiz[i],quiz[j]]=[quiz[j],quiz[i]];}quiz=quiz.slice(0,10);quizIndex=0;quizRemembered=0;quizAnswered=false;renderQuiz();$('#quizDialog').showModal();}
function renderQuiz(){const content=$('#quizContent');if(quizIndex>=quiz.length){content.innerHTML=`<div class="modal-body"><div class="eyebrow">本轮回想完成</div><h3 class="quiz-pattern">又连接了 ${quiz.length} 个节点。</h3><p class="quiz-hint">记住 ${quizRemembered} 条 · 待复习 ${quiz.length-quizRemembered} 条<br>判断结果已更新到学习进度。</p><div class="quiz-buttons"><button class="secondary" id="quizAgain">再来一轮</button><button class="primary" id="quizFinish">返回导图</button></div></div>`;return;}const d=quiz[quizIndex];content.innerHTML=`<div class="quiz-progress"><i style="width:${quizIndex/quiz.length*100}%"></i></div><div class="modal-body"><div class="quiz-meta"><span>${CAT[d.category].name}</span><span>${quizIndex+1} / ${quiz.length}</span></div><h3 class="quiz-pattern" lang="ja">${esc(d.pattern)}</h3><p class="quiz-example" lang="ja">${esc(d.example)}</p>${quizAnswered?`<div class="quiz-reveal"><strong>${esc(d.meaning)}</strong><p>${esc(d.translation)}</p><p><b>接续：</b>${esc(d.connection)}</p><p><b>线索：</b>${esc(d.cue)}</p></div><div class="quiz-buttons"><button class="secondary" id="quizRetry">还没记住</button><button class="primary" id="quizKnown">记住了 ✓</button></div>`:'<p class="quiz-hint">回想：含义是什么？前面该接什么形式？</p><div class="quiz-buttons"><button class="primary" id="quizReveal">查看答案</button></div>'}</div>`;}
function answerQuiz(known){const id=quiz[quizIndex].id;progress.known=progress.known.filter(x=>x!==id);if(known){progress.known.push(id);quizRemembered++;}save();quizIndex++;quizAnswered=false;renderQuiz();renderMap();renderDetail();}
function openHelp(){$('#helpDialog').showModal();}
document.addEventListener('click',e=>{const el=e.target.closest('button');if(!el)return;if(el.hasAttribute('data-cat')){chooseCategory(el.dataset.cat);return;}if(el.dataset.entry){openEntry(el.dataset.entry);return;}if(el.hasAttribute('data-reset')){chooseCategory(null);return;}if(el.hasAttribute('data-prev')){stepEntry(-1);return;}if(el.hasAttribute('data-next')){stepEntry(1);return;}switch(el.id){case'mapRoot':case'breadcrumb':chooseCategory(null);break;case'compareBtn':case'mobileCompare':showCompare();break;case'clearSearch':query='';renderMap();$('#search').focus();break;case'translationBtn':translationOpen=!translationOpen;renderDetail();$('#translationBtn').focus();break;case'knownBtn':toggleProgress('known');$('#knownBtn').focus();break;case'starBtn':toggleProgress('star');$('#starBtn').focus();break;case'closeDetail':closeDetail();break;case'helpBtn':case'sourceBtn':openHelp();break;case'closeHelp':$('#helpDialog').close();break;case'quizBtn':startQuiz();break;case'closeQuiz':case'quizFinish':$('#quizDialog').close();break;case'quizAgain':$('#quizDialog').close();startQuiz();break;case'quizReveal':quizAnswered=true;renderQuiz();$('#quizKnown').focus();break;case'quizRetry':answerQuiz(false);break;case'quizKnown':answerQuiz(true);break;case'exportBtn':exportProgress();break;case'importBtn':$('#importFile').click();break;}});
$('#search').addEventListener('input',e=>{query=e.target.value.trim();if(query){selectedCat=null;mode='map';}renderMap();});
$('#filter').addEventListener('change',e=>{filter=e.target.value;mode='map';renderMap();});
$('#mobileCategory').addEventListener('change',e=>chooseCategory(e.target.value));
$('#detailBackdrop').addEventListener('click',closeDetail);
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&$('#detail').classList.contains('mobile-open'))closeDetail();if(e.key==='Tab'&&$('#detail').classList.contains('mobile-open')){const focusable=[...$('#detail').querySelectorAll('button,a[href]')].filter(el=>!el.disabled);const first=focusable[0],last=focusable[focusable.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}}});
function exportProgress(){const blob=new Blob([JSON.stringify({format:KEY,exportedAt:new Date().toISOString(),...progress},null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='n1-grammar-progress.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),2000);toast('学习进度已导出');}
$('#importFile').addEventListener('change',async e=>{const file=e.target.files[0];if(!file)return;try{if(file.size>1000000)throw Error();const data=JSON.parse(await file.text());if(data.format!==KEY||!Array.isArray(data.known)||!Array.isArray(data.star))throw Error();for(const k of ['known','star'])progress[k]=[...new Set([...progress[k],...data[k].filter(id=>typeof id==='string'&&BYID[id])])];save();renderMap();renderDetail();toast('进度已合并');}catch{toast('无法导入，请选择本页面导出的进度 JSON 文件。');}e.target.value='';});
const sourceMap=new Map();DATA.forEach(d=>(d.sources||[]).forEach(s=>{if(/^https?:\/\//.test(s.url))sourceMap.set(s.url,s.title);}));
$('#sourceList').innerHTML='<details><summary>展开 '+sourceMap.size+' 个语法参考页面</summary><ul>'+[...sourceMap].map(([url,title])=>`<li><a href="${esc(url)}" target="_blank" rel="noopener noreferrer">${esc(title)}</a></li>`).join('')+'</ul></details>';
new ResizeObserver(drawBranches).observe($('#main'));
window.addEventListener('resize',()=>{if(window.innerWidth>1270&&$('#detail').classList.contains('mobile-open'))closeDetail();});
updateProgress();renderMap();renderDetail();
</script>
</body>
</html>
