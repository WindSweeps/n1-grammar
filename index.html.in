<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light">
<meta name="theme-color" content="#285c49">
<meta name="description" content="用中文释义、接续、原创例句和回想自测学习日语 N1 语法，12个语义分支，108个学习条目。">
<title>N1 语法思维导图 · 文法の森</title>
<style>
:root{--canvas:#f5f5ef;--surface:#fffefa;--ink:#203b32;--muted:#63736a;--line:#dbe1d6;--green:#285c49;--tint:#eaf0e5;--gold:#a86035;--focus:#b15a28;--shadow:0 12px 40px #203b3210;--sans:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;--serif:"Songti SC","Noto Serif CJK SC","Hiragino Mincho ProN",Georgia,serif}
*{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--canvas);font-family:var(--sans);font-size:14px;line-height:1.6}button,input,select{font:inherit}button,a,input,select{-webkit-tap-highlight-color:transparent}button{cursor:pointer;color:inherit}button:disabled{cursor:default;opacity:.5}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--focus);outline-offset:4px}button{border:0}a{color:var(--green);text-underline-offset:4px}h1,h2,h3,p{margin:0}button:hover{filter:brightness(.97)}.wrap{max-width:1760px;margin:auto;padding:0 36px}.top{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:12px}.brand-mark{width:34px;height:38px;background:var(--green);color:#fffefa;display:grid;place-items:center;font-family:var(--serif);font-size:22px;border-radius:10px 3px}.brand strong{font-family:var(--serif);font-size:21px;font-weight:600}.brand small{margin-left:15px;font-size:11px;letter-spacing:2px;color:var(--muted)}.top-actions{display:flex;gap:12px;align-items:center}.plain,.primary,.secondary{min-height:42px;padding:9px 16px;border-radius:7px;display:inline-flex;align-items:center;justify-content:center;gap:7px}.plain{background:transparent;color:var(--muted)}.primary{background:var(--green);color:white}.secondary{border:1px solid var(--line);background:var(--surface)}.intro{display:flex;align-items:flex-end;justify-content:space-between;padding:29px 0 24px;gap:24px}.eyebrow{font-size:11px;font-weight:650;letter-spacing:2px;color:var(--gold);margin-bottom:5px}h1{font-size:32px;letter-spacing:1px;font-family:var(--serif);font-weight:600;line-height:1.5}.intro p{color:var(--muted);font-size:13px;margin-top:6px}.intro-note{text-align:right;min-width:182px}.intro-note strong{font-family:Georgia,serif;font-size:25px;font-weight:400}.intro-note span{font-size:12px;color:var(--muted);margin:0 5px}.intro-note .line{height:4px;background:var(--line);border-radius:4px;margin-top:10px;overflow:hidden}.intro-note .line i{display:block;background:var(--green);height:100%;width:0;transition:width .2s}.workspace{display:grid;grid-template-columns:180px minmax(0,1fr) 330px;gap:22px;align-items:start}.sidebar{padding-top:4px;position:sticky;top:20px}.nav-title{font-size:11px;color:var(--muted);letter-spacing:1.5px;padding:0 12px 10px}.nav-item{width:100%;display:flex;align-items:center;text-align:left;gap:9px;min-height:42px;background:transparent;border-radius:7px;padding:9px 11px;margin-bottom:3px;font-size:13px}.nav-item.active{background:var(--green);color:#fff}.nav-item .number{font-size:10px;opacity:.65;font-variant-numeric:tabular-nums}.nav-item .count{margin-left:auto;font-size:10px;opacity:.7}.nav-sep{height:1px;background:var(--line);margin:13px 10px}.nav-caption{font-size:11px;color:var(--muted);padding:15px 11px}.mobile-nav{display:none}.center{min-width:0}.map-panel{border:1px solid var(--line);background:var(--surface);border-radius:13px;overflow:hidden;box-shadow:var(--shadow)}.tools{display:flex;align-items:center;gap:12px;padding:15px 18px;border-bottom:1px solid var(--line)}.searchbox{display:flex;align-items:center;gap:9px;flex:1;min-width:0;background:#f4f5ef;border:1px solid transparent;border-radius:7px;padding:0 11px}.searchbox:focus-within{border-color:var(--green)}.searchbox span{font-size:18px;color:var(--muted)}.searchbox input{border:0;background:transparent;outline:none;min-width:0;width:100%;height:40px;color:var(--ink);font-size:12px}.clear{background:transparent;font-size:19px;padding:0 3px;color:var(--muted)}select{background:var(--surface);border:1px solid var(--line);color:var(--ink);border-radius:7px;min-height:40px;padding:7px 25px 7px 9px;font-size:12px;max-width:140px}.map-heading{padding:17px 22px 0;display:flex;justify-content:space-between;align-items:center;gap:10px}.crumb{font-size:12px;color:var(--muted);background:transparent;padding:0;min-height:30px}.crumb b{color:var(--ink);font-weight:550}.map-tag{font-size:10px;white-space:nowrap;color:var(--muted);letter-spacing:.5px}.mindmap{position:relative;min-height:622px;padding:22px;display:grid;grid-template-columns:minmax(0,1fr) 112px minmax(0,1fr);grid-template-rows:repeat(6,1fr);column-gap:24px;row-gap:12px;align-items:center}.mindmap.category{min-height:554px;grid-template-rows:repeat(5,1fr)}.branches{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}.branches path{fill:none;stroke:#c5d4c4;stroke-width:1.3}.root-node{z-index:1;grid-column:2;grid-row:1/-1;width:112px;height:112px;align-self:center;justify-self:center;display:flex;align-items:center;justify-content:center;flex-direction:column;background:var(--green);color:white;border-radius:50%;box-shadow:0 0 0 8px var(--surface),0 0 0 9px #d3ddcf}.root-node strong{font-family:var(--serif);font-size:26px;font-weight:500;line-height:1.3}.root-node span{font-size:12px;margin-top:6px}.root-node small{font-size:9px;color:#d2e2d3;letter-spacing:.5px}.category .root-node strong{font-family:var(--sans);font-size:15px;max-width:90px}.node{z-index:1;position:relative;background:var(--surface);border:1px solid var(--line);border-radius:8px;text-align:left;padding:12px 14px;min-height:78px;width:100%;display:flex;flex-direction:column;justify-content:center;transition:border-color .15s,background .15s}.node:hover{border-color:#7b9b83;background:#f7faf2;filter:none}.node.selected{border-color:var(--green);background:var(--tint);box-shadow:0 0 0 1px var(--green)}.node .node-title{font-size:14px;font-weight:550;line-height:1.4;overflow-wrap:anywhere}.node.grammar .node-title{font-family:var(--serif);font-size:16px}.node .node-sub{font-size:11px;color:var(--muted);margin-top:5px;line-height:1.5}.node .node-num{font-size:9px;color:var(--gold);position:absolute;right:9px;top:6px}.node .state-dot{position:absolute;right:8px;bottom:7px;font-size:10px;color:var(--green)}.node.group{padding-right:26px}.node.group .node-title{font-size:13px}.node.done{border-left:3px solid var(--green)}.map-foot{border-top:1px solid var(--line);padding:12px 20px;display:flex;justify-content:space-between;align-items:center;gap:10px;color:var(--muted);font-size:10px}.key{display:flex;align-items:center;gap:12px}.key span{white-space:nowrap}.key i{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--green);margin-right:5px}.under-map{padding:16px 3px;display:flex;justify-content:space-between;gap:12px;font-size:11px;color:var(--muted)}.under-map button{font-size:11px;padding:0;background:transparent;color:var(--green);text-decoration:underline;text-underline-offset:4px}.detail{background:var(--surface);border:1px solid var(--line);border-radius:13px;overflow:hidden;position:sticky;top:20px;box-shadow:var(--shadow)}.detail-inner{padding:22px}.detail-kicker{font-size:10px;color:var(--gold);letter-spacing:1.5px;text-transform:uppercase}.detail h2{font-family:var(--serif);font-size:25px;font-weight:550;line-height:1.55;margin:10px 0 8px;overflow-wrap:anywhere}.detail .meaning{font-size:14px;color:var(--green);line-height:1.65;margin-bottom:18px}.detail-block{padding:16px 0;border-top:1px solid var(--line)}.label{font-size:10px;letter-spacing:1px;color:var(--muted);margin-bottom:7px;font-weight:600}.detail-block p{font-size:12px;line-height:1.9}.connection{font-family:var(--sans);background:#f0f3ec;border-radius:6px;padding:11px 12px;font-size:12px;line-height:1.8}.example{font-family:var(--serif);font-size:17px!important;line-height:1.9!important}.translation{color:var(--muted);font-size:12px;line-height:1.7;margin-top:9px}.translation-btn{font-size:11px;padding:3px 0;background:transparent;color:var(--green);margin-top:5px;text-decoration:underline;text-underline-offset:4px;min-height:32px}.cue{padding:12px 13px;border-left:2px solid #ba9160;background:#f8f3e8;border-radius:0 6px 6px 0;font-size:12px;line-height:1.8}.detail-actions{display:flex;gap:8px;position:sticky;bottom:0;padding:13px 18px;background:var(--surface);border-top:1px solid var(--line)}.detail-actions .primary,.detail-actions .secondary{flex:1;font-size:12px}.detail-actions .star{flex:0 0 74px}.detail-nav{display:flex;justify-content:space-between;margin-top:17px;gap:10px}.detail-nav button{background:transparent;min-height:34px;color:var(--muted);font-size:11px}.related{display:flex;flex-wrap:wrap;gap:6px}.related button{background:var(--tint);padding:5px 8px;border-radius:5px;min-height:32px;font-size:11px}.source-links{font-size:10px;color:var(--muted);margin-top:10px;overflow-wrap:anywhere}.source-links a{display:block;margin-top:5px}.bridge{display:inline-block;border:1px solid #cab388;color:#805a2f;padding:2px 6px;font-size:9px;border-radius:4px;margin-bottom:8px}.guide-title{font-family:var(--serif);font-size:27px;line-height:1.8;margin:10px 0}.guide-copy{font-size:12px;color:var(--muted);line-height:1.9}.guide-steps{margin:23px 0 20px}.step{display:grid;grid-template-columns:24px 1fr;gap:10px;padding:15px 0;border-top:1px solid var(--line)}.step b{font-family:Georgia,serif;color:var(--gold);font-size:17px;font-weight:400}.step strong{font-size:12px;font-weight:550}.step p{font-size:11px;color:var(--muted);margin-top:4px}.guide-prompt{padding:15px;background:var(--tint);border-radius:8px;font-family:var(--serif);font-size:15px;line-height:1.9}.result-area{padding:20px;min-height:540px}.result-heading{font-size:12px;color:var(--muted);margin:0 0 17px}.result-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.result-grid .node{min-height:88px}.empty{padding:80px 20px;text-align:center;color:var(--muted)}.empty strong{font-family:var(--serif);font-size:24px;color:var(--ink);font-weight:500}.empty p{font-size:12px;margin-top:12px}.empty button{margin-top:20px}.compare-list{display:grid;gap:16px}.compare{border:1px solid var(--line);border-radius:9px;padding:18px}.compare h3{font-size:15px;font-family:var(--serif);font-weight:600;margin-bottom:7px}.compare>p{font-size:12px;color:var(--muted);margin-bottom:12px}.compare-row{border-top:1px solid var(--line);padding-top:10px;margin-top:10px}.compare-row button{padding:0;min-height:32px;text-align:left;background:transparent;font-family:var(--serif);font-size:16px;color:var(--green)}.compare-row p{font-size:12px;line-height:1.8}.close-detail{display:none}.footer{border-top:1px solid var(--line);padding:22px 0 28px;margin-top:10px;display:flex;justify-content:space-between;gap:20px;font-size:10px;color:var(--muted)}.footer a{font-size:10px}.footer p{max-width:830px}.toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%);background:var(--ink);color:white;padding:10px 18px;border-radius:8px;z-index:40;box-shadow:var(--shadow);font-size:12px;max-width:90vw;text-align:center}.hidden,[hidden]{display:none!important}dialog{color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:16px;box-shadow:0 30px 90px #18362630;padding:0;width:min(600px,calc(100vw - 30px));max-height:90vh}dialog::backdrop{background:#213b325b;backdrop-filter:blur(3px)}.modal-head{display:flex;justify-content:space-between;align-items:center;padding:18px 25px;border-bottom:1px solid var(--line)}.modal-head h2{font-size:14px;font-weight:600}.icon-close{background:transparent;font-size:24px;min-width:36px;min-height:36px;line-height:1}.modal-body{padding:26px}.quiz-meta{display:flex;justify-content:space-between;color:var(--muted);font-size:11px}.quiz-pattern{font-family:var(--serif);font-weight:500;font-size:32px;text-align:center;padding:25px 0 16px;line-height:1.6;overflow-wrap:anywhere}.quiz-example{font-size:18px;text-align:center;font-family:var(--serif);line-height:1.9}.quiz-hint{text-align:center;color:var(--muted);font-size:12px;margin:18px 0 23px}.quiz-reveal{padding:18px;background:var(--tint);border-radius:9px;margin-top:20px}.quiz-reveal strong{font-size:17px;font-weight:500}.quiz-reveal p{font-size:13px;line-height:1.9;margin-top:8px}.quiz-buttons{display:flex;gap:10px;margin-top:22px}.quiz-buttons button{flex:1}.quiz-progress{height:3px;background:var(--line)}.quiz-progress i{height:100%;display:block;background:var(--green)}.help-body{font-size:13px;line-height:1.9}.help-body h3{font-size:14px;margin:20px 0 5px}.help-body h3:first-child{margin-top:0}.help-body ul{padding-left:19px;margin:8px 0}.help-body p{margin:8px 0}.help-body a{overflow-wrap:anywhere}.save-note{font-size:11px;color:var(--muted)}.backup-controls{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.backup-controls button{font-size:12px}.backdrop{display:none}
@media(min-width:1600px){.workspace{grid-template-columns:200px minmax(0,1fr) 355px;gap:26px}.mindmap{column-gap:40px;padding:28px}.node{min-height:82px;padding:13px 19px}}
@media(max-width:1270px){.workspace{grid-template-columns:162px minmax(0,1fr);gap:18px}.detail{display:none}.detail.mobile-open{display:block;position:fixed;top:0;right:0;bottom:0;border-radius:16px 0 0 16px;width:380px;max-width:94vw;overflow:auto;z-index:31;box-shadow:-20px 0 80px #18362620}.close-detail{display:flex;justify-content:space-between;align-items:center;padding:12px 20px;border-bottom:1px solid var(--line);font-size:11px;color:var(--muted)}.backdrop.open{display:block;position:fixed;inset:0;background:#203b3255;z-index:30}.wrap{padding:0 28px}.mindmap{min-height:610px}.intro{padding:25px 0 22px}}
@media(max-width:760px){.wrap{padding:0 16px}.top{height:66px}.brand small{display:none}.brand strong{font-size:18px}.top-actions{gap:1px}.top-actions .plain{padding:8px 9px;font-size:11px}.top-actions .primary{padding:8px 12px;min-height:38px;font-size:12px}.brand-mark{width:29px;height:32px;font-size:19px}.intro{padding:23px 0 19px;align-items:center;gap:8px}h1{font-size:25px;letter-spacing:0}.intro p{font-size:11px;max-width:225px}.eyebrow{font-size:9px;letter-spacing:1.3px}.intro-note{min-width:65px}.intro-note strong{font-size:22px}.intro-note span{font-size:10px;margin:0 2px}.intro-note .total-label{display:none}.workspace{display:block}.sidebar{display:none}.mobile-nav{display:flex;gap:7px;padding:0 0 12px;align-items:center}.mobile-nav select{flex:1;max-width:none;min-width:0;font-size:12px}.mobile-nav button{font-size:11px;min-height:40px;padding:7px 11px}.tools{padding:12px;gap:7px}.tools select{width:93px;flex:0 0 93px}.searchbox{padding:0 8px}.searchbox input{font-size:11px}.map-heading{padding:12px 15px 0}.map-tag{font-size:9px}.mindmap,.mindmap.category{display:flex;flex-direction:column;align-items:stretch;gap:12px;padding:24px 18px 25px 51px;min-height:0}.mindmap::before{content:"";position:absolute;left:29px;top:45px;bottom:64px;border-left:1px solid #bbceb9}.branches{display:none}.root-node{align-self:flex-start;justify-self:auto;width:auto;height:auto;min-height:46px;border-radius:8px;box-shadow:none;flex-direction:row;gap:9px;padding:10px 14px;margin:0 0 10px -39px}.root-node strong,.category .root-node strong{font-family:var(--serif);font-size:18px;max-width:none}.root-node span{margin:0;font-size:11px}.root-node small{font-size:9px}.node{min-height:70px;padding:12px 15px}.node:before{content:"";position:absolute;width:23px;border-top:1px solid #bbceb9;left:-23px;top:50%}.node.group .node-title{font-size:14px}.node .node-sub{font-size:11px}.node.grammar .node-title{font-size:17px}.node .node-num{font-size:10px;right:12px;top:9px}.map-foot{padding:11px 15px;font-size:9px;flex-wrap:wrap}.under-map{font-size:10px;align-items:flex-start}.under-map span{max-width:65%}.result-grid{grid-template-columns:1fr}.result-area{padding:16px;min-height:400px}.result-area .node::before{display:none}.footer{font-size:10px;flex-direction:column;gap:8px}.footer p{line-height:1.9}.modal-body{padding:20px}.quiz-pattern{font-size:27px}.quiz-example{font-size:17px}.detail.mobile-open{width:420px}.compare{padding:14px}.intro-note .line{margin-top:5px}.help-body{font-size:12px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
@media print{.top-actions,.sidebar,.tools,.mobile-nav,.detail-actions,.under-map,.intro-note,.close-detail,.footer,.backdrop,.toast{display:none!important}.wrap{padding:0}.workspace{display:block}.detail{display:block;position:static;border:0;box-shadow:none}.map-panel{box-shadow:none}.mindmap{break-inside:avoid}.detail-inner{padding:20px 0}body{background:white}.intro{padding:14px 0}}

__MOBILE_CSS__
/* Japanese readings are attached to the original word, not substituted for it. */
.jp-ruby{ruby-position:over;ruby-align:center}
.jp-ruby rt{font-family:var(--sans);font-size:.55em;font-weight:400;letter-spacing:0;color:var(--muted);line-height:1.1;user-select:none}
.jp-ruby rp{display:none}
.furigana-off .jp-ruby rt{display:none}
.node.grammar .node-title{line-height:1.95}
.detail h2,.quiz-pattern{line-height:1.9}
.root-node .jp-ruby rt{color:#e1ece3}
.furigana-toggle{flex-shrink:0;border:1px solid var(--line);font-size:12px;min-height:40px;white-space:nowrap;padding:7px 10px}
.furigana-toggle[aria-pressed="true"]{color:var(--green);background:var(--tint)}
.close-detail #detailPosition{flex:1;text-align:left}
.modal-head .furigana-toggle{margin-left:auto;margin-right:8px}
@media(max-width:760px){.furigana-toggle{min-height:44px;padding:7px 9px;font-size:12px}.top-actions{gap:6px}.brand{gap:8px}.brand strong{font-size:17px}.close-detail #detailPosition{font-size:11px}.root-node span .jp-ruby rt{font-size:.65em}.node.grammar .node-title{font-size:18px}.detail.mobile-open .example{line-height:2.25!important}}
@media print{.furigana-toggle{display:none!important}}

</style>
</head>
<body>
<div class="wrap" id="app">
<header class="top"><div class="brand"><span class="brand-mark" aria-hidden="true">文</span><strong lang="ja"><ruby class="jp-ruby">文法<rp>（</rp><rt aria-hidden="true">ぶんぽう</rt><rp>）</rp></ruby>の<ruby class="jp-ruby">森<rp>（</rp><rt aria-hidden="true">もり</rt><rp>）</rp></ruby></strong><small>GRAMMAR ATLAS</small></div><div class="top-actions"><button class="plain furigana-toggle" data-furigana aria-label="日语注音" aria-pressed="true">注音：开</button><button class="plain" id="helpBtn">使用指南</button><button class="primary" id="quizBtn">开始自测 <span aria-hidden="true">↗</span></button></div></header>
<section class="intro"><div><div class="eyebrow">JLPT N1 · 按语义建立连接</div><h1>N1 语法思维导图</h1><p>先理解一句话想表达什么，再记住它如何表达。</p></div><div class="intro-note" aria-live="polite"><strong id="masteredCount">0</strong><span>/ <span id="totalCount">108</span><span class="total-label"> 已掌握</span></span><div class="line" role="progressbar" aria-label="学习进度" aria-valuemin="0" aria-valuemax="108" aria-valuenow="0"><i id="progressFill"></i></div></div></section>
<div class="workspace">
<aside class="sidebar" aria-label="语法分类"><div class="nav-title">学习路径</div><nav id="categoryNav"></nav><div class="nav-sep"></div><button class="nav-item" id="compareBtn"><span aria-hidden="true">⇄</span> 易混辨析 <span class="count">8 组</span></button><div class="nav-caption">理解 → 对比 → 回想<br>每天走完一个分支。</div></aside>
<main class="center" id="main"><div class="mobile-nav"><label for="mobileCategory" class="hidden">语法分类</label><select id="mobileCategory" aria-label="选择语法分类"></select><button class="secondary" id="mobileCompare">⇄ 易混辨析</button></div><div id="mobileSession" class="mobile-session"><span class="session-copy"></span><button id="mobileReview" class="secondary">复习本分支</button></div><section class="map-panel" aria-label="交互思维导图"><div class="tools"><div class="searchbox"><span aria-hidden="true">⌕</span><input type="search" id="search" placeholder="搜索语法、中文含义或接续…" aria-label="搜索全部语法" autocomplete="off"><button class="clear" type="button" id="clearSearch" aria-label="清空搜索" hidden>×</button></div><select id="filter" aria-label="学习状态筛选"><option value="all">全部语法</option><option value="new">待学习</option><option value="known">已掌握</option><option value="star">已收藏</option></select></div><div class="map-heading"><button class="crumb" id="breadcrumb">语法地图 / <b>全景</b></button><div class="map-context"><button id="searchAll" class="plain" hidden>搜索全部分类</button><span class="map-tag" id="mapTag" aria-live="polite">12 个语义分支</span></div></div><div id="mapContent"></div><div class="map-foot"><span id="mapHint">点击分支展开 · 点击中心返回全景</span><div class="key"><span><i></i>已掌握</span><span>☆ 收藏留待复习</span></div></div></section><div class="under-map"><span id="storageNote">学习进度自动保存在当前浏览器</span><button id="sourceBtn">范围与参考来源 ↗</button></div></main>
<aside class="detail" id="detail" aria-label="语法详情"><div class="close-detail"><button id="closeDetail" class="plain" aria-label="返回语法列表">← 返回</button><span id="detailPosition">语法学习卡</span><button class="plain furigana-toggle" data-furigana aria-label="日语注音" aria-pressed="true">注音：开</button></div><div id="detailContent"></div></aside>
